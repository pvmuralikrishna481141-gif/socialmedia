# Copy this file to ".env" and fill in your own values. Never commit the real ".env" file.

# MongoDB connection string.
# Local:      mongodb://127.0.0.1:27017/socially
# Atlas:      mongodb+srv://<user>:<password>@<cluster-url>/socially?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/socially

# Port the Express server listens on
PORT=5000

# URL of the React frontend (used for the CORS allow-list)
CLIENT_URL=http://localhost:5173
